{
 "_comment": "Curated rule inventory for the Evals tab coverage map (docs/policies/evals.md). One entry per rule; `gates` lists the task gate names that exercise it; `hook` is the script name for kind=hook (a structural test checks every hook in .claude/settings.json is listed). Seeded 2026-11-11 from a scan of CLAUDE.md, settings.json and docs/policies.",
 "rules": [
  {
   "id": "hook-session-start",
   "title": "Session start prints phase, next step and handoff note",
   "kind": "hook",
   "source": ".claude/settings.json (SessionStart)",
   "gates": [],
   "hook": "session_start.py"
  },
  {
   "id": "hook-guard-large-read",
   "title": "Whole reads of large files are blocked",
   "kind": "hook",
   "source": ".claude/settings.json (PreToolUse Read|Bash)",
   "gates": [
    "token-economy"
   ],
   "hook": "guard_large_read.py"
  },
  {
   "id": "hook-guard-bash-policy",
   "title": "Direct deploys, --no-verify and secret-file access in Bash are blocked",
   "kind": "hook",
   "source": ".claude/settings.json (PreToolUse Bash)",
   "gates": [
    "deploy-guard"
   ],
   "hook": "guard_bash_policy.py"
  },
  {
   "id": "hook-docs-changed",
   "title": "Doc edits remind the agent to sync docs and the index",
   "kind": "hook",
   "source": ".claude/settings.json (PostToolUse Edit|Write)",
   "gates": [],
   "hook": "docs_changed.py"
  },
  {
   "id": "hook-record-tokens",
   "title": "Session end records token use",
   "kind": "hook",
   "source": ".claude/settings.json (SessionEnd)",

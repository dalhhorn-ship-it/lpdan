{
  "$comment": "Single source of project configuration for agents, hooks and scripts. Edit via /choose-path and /retro; humans may edit freely.",
  "template": {
    "name": "danfactory",
    "decision_tree_version": "1.1.0"
  },
  "project": {
    "name": "Landing Page Dan Factory",
    "one_liner": "Free landing page that teaches vibe coders to build with Claude the danfactory way, with a challenge campaign."
  },
  "phase": "build",
  "paths": {
    "primary": "documents-content",
    "secondary": [
      "software-product"
    ]
  },
  "agents": {
    "roster": [
      "product-manager",
      "software-architect",
      "developer",
      "test-runner",
      "reviewer",
      "task-completion-validator",
      "code-quality-pragmatist",
      "karen",
      "jenny",
      "ui-comprehensive-tester",
      "deploy-watcher",
      "doc-keeper"
    ],
    "routing": "docs/operating-model/AGENT-ROUTING.md"
  },
  "commands": {
    "test": "python3 tests/check_page.py && node tests/smoke.mjs",
    "test_affected": "python3 tests/check_page.py",
    "coverage": "",
    "lint": "node --check public/copy.js && node --check tests/smoke.mjs && python3 -m py_compile tests/check_page.py",
    "build": "npm run build",
    "deploy": ""
  },
  "coverage_report": {
    "format": "auto",
    "file": ""
  },
  "budgets": {
    "test_seconds": 30,
    "affected_test_seconds": 5,
    "deploy_seconds": 180,
    "min_coverage_pct": 80,
    "max_coverage_drop_pct": 2,
    "large_read_lines": 350,
    "session_weighted_tokens_warn": 750000,
    "context_handoff_tokens": 120000
  },
  "integrations": {
    "codegraph": false,
    "deploy": {
      "provider": "cloudflare",
      "method": "git",
      "production_branch": "main",
      "product": "workers",
      "project_name": "danfactory",
      "production_url": "https://danfactory.dalhhorn.workers.dev",
      "worker_name": "danfactory",
      "workers_subdomain": "dalhhorn",
      "preview_url_pattern": "https://{alias}-{worker}.{subdomain}.workers.dev",
      "route": "B-github-actions"
    },
    "skills": {
      "security-audit": {
        "repo": "https://github.com/cloudflare/security-audit-skill",
        "ref": "main",
        "path": "skills/security-audit",
        "license": "MIT",
        "model_invocable": false
      },
      "cloudflare-deploy": {
        "repo": "https://github.com/davila7/claude-code-templates",
        "ref": "main",
        "path": "cli-tool/components/skills/development/cloudflare-deploy",
        "license": "Apache-2.0",
        "model_invocable": false
      }
    },
    "dashboard_url": ""
  }
}
